<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.darlinghq.iokitd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/sbin/iokitd</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>org.darlinghq.iokitd</key>
		<true/>
		<key>com.apple.PowerManagement.control</key>
		<true/>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/iokitd.out</string>
	<key>StandardErrorPath</key>
	<string>/tmp/iokitd.err</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DISPLAY</key>
		<string>:1</string>
		<key>XAUTHORITY</key>
		<string>/tmp/xauth</string>
	</dict>
</dict>
</plist>

